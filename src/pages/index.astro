---
import SceneNavigator from '../components/SceneNavigator.astro';
import BrandLogo from '../components/BrandLogo.astro';
import products from '../data/products.json';
import { site, inquiryLive } from '../config/site.mjs';
import SEO from '../components/SEO.astro';
import TrackingHead from '../components/TrackingHead.astro';
import TrackingBody from '../components/TrackingBody.astro';
import imagePaths from '../data/image-paths.json';
import '../styles/atrium.css';
import '../styles/atrium-v2.css';
import '../styles/scene-explorer.css';
import '../styles/hero-composition.css';
const scenes = [
{ id:'daytime', label:'Daytime', chapter:'Daylight', title:'Made for the outdoors.\nDesigned around the sun.', body:'Start with the space, the mounting position and the available daylight. Keep the solar surface clear of shade.', product:'multi-head', family:'Multi-head sensor light', hint:'Daytime courtyard', image:'/images/scenes/daytime.webp' },
{ id:'charging', label:'Solar charging', chapter:'Daylight', title:'Capture the daylight.\nPrepare for the evening.', body:'The photovoltaic panel turns sunlight into electrical energy. Panel exposure and the selected battery configuration shape the daily energy balance.', product:'multi-head', family:'Split-panel security light', hint:'Sunlight to stored energy', image:'/images/scenes/charging.webp' },
{ id:'passerby', label:'Motion response', chapter:'After dark', title:'A little movement.\nA clearer approach.', body:'A motion-sensor format can bring light to an approaching person. Confirm the detection range and chosen operating mode with the final model.', product:'multi-head', family:'Multi-head sensor light', hint:'Pedestrian approach', image:'/images/scenes/passerby.webp' },
{ id:'security', label:'Boundary access', chapter:'After dark', title:'Bring light\nto the unexpected.', body:'Illuminate movement near an entrance or boundary. This illustrates a lighting response, not person identification or an alarm system.', product:'multi-head', family:'Split-panel security light', hint:'Access & perimeter lighting', image:'/images/scenes/security.webp' },
{ id:'courtyard', label:'Courtyard', chapter:'After dark', title:'An outdoor space.\nA different atmosphere.', body:'Bring light to courtyard access and the places people gather. Adjust the light direction around the layout and keep the solar panel exposed.', product:'multi-head', family:'D6 three-head solar sensor light', hint:'Landscape & hospitality', image:'/images/scenes/courtyard.webp' },
{ id:'driveway', label:'Coming home', chapter:'After dark', title:'A clearer welcome.\nEvery evening.', body:'Direct adjustable light heads toward the approach. Match panel exposure, mounting position and sensor response to the site.', product:'multi-head', family:'Multi-head sensor light', hint:'Residential & property projects', image:'/images/scenes/driveway.webp' },
{ id:'energy', label:'Energy journey', chapter:'Inside the light', title:'From solar energy\nto useful light.', body:'Solar panel, battery, controller and LED work as a system. This exploded view illustrates the energy path, not the exact internal construction.', product:'multi-head', family:'Multi-head sensor light', hint:'How solar lighting works', image:'/images/scenes/energy.webp' },
{ id:'coverage', label:'Light coverage', chapter:'Inside the light', title:'Direct the light.\nUnderstand the space.', body:'Head adjustment changes the direction of light. Final coverage depends on optics, output and mounting height; confirm it with selected-model data.', product:'multi-head', family:'Multi-head sensor light', hint:'Small fixture · Local illumination', image:'/images/scenes/coverage-scale-corrected.webp' }
];
const heroScenes: Array<{id:string;label:string;caption:string;kind:string;src:string;position:string;productBounds?:number[]}> = [
  {id:'factory',label:'Factory floor',caption:'On the production floor',kind:'Factory photograph',src:'/images/factory-real/production-daylight.webp',position:'50% 64%'},
  {id:'courtyard',label:'Courtyard',caption:'Lighting outdoor living',kind:'Application concept',src:'/images/scenes/courtyard.webp',position:'64% 50%',productBounds:[0.811, 0.253, 0.868, 0.326]},
  {id:'assembly',label:'Assembly',caption:'The people behind the product',kind:'Factory photograph',src:'/images/factory-real/assembly-line.webp',position:'50% 55%'},
  {id:'entrance',label:'Entrance',caption:'Small fixture. Everyday use.',kind:'Application concept',src:'/images/scenes/coverage-scale-corrected.webp',position:'68% 50%',productBounds:[0.811, 0.181, 0.863, 0.246]},
  {id:'panel-check',label:'Panel checks',caption:'From solar panel to finished light',kind:'Factory photograph',src:'/images/factory-real/panel-check.webp',position:'50% 48%'},
  {id:'daytime',label:'Daytime',caption:'At home in the daylight',kind:'Application concept',src:'/images/scenes/daytime.webp',position:'62% 50%',productBounds:[0.811, 0.254, 0.868, 0.327]},
  {id:'moulding',label:'Moulding',caption:'A closer look at production',kind:'Factory photograph',src:'/images/factory-real/moulding.webp',position:'50% 50%'},
  {id:'coming-home',label:'Coming home',caption:'A clearer welcome after dark',kind:'Application concept',src:'/images/scenes/driveway.webp',position:'62% 50%',productBounds:[0.7, 0.155, 0.747, 0.203]},
  {id:'warehouse',label:'Packing',caption:'Packed for the next step',kind:'Factory photograph',src:'/images/factory-real/warehouse.webp',position:'50% 55%'},
  {id:'approach',label:'Motion response',caption:'Light along the approach',kind:'Application concept',src:'/images/scenes/passerby.webp',position:'64% 50%',productBounds:[0.853, 0.271, 0.913, 0.339]}
];
const factoryProof = [
  {src:'/images/factory-real/assembly-line.webp',title:'Hands-on assembly',caption:'People, parts and lighting products on the assembly bench.',alt:'Workers assembling lighting units with hand tools'},
  {src:'/images/factory-real/panel-check.webp',title:'Solar-panel checks',caption:'Panel connections and instruments at the workbench.',alt:'Worker connecting leads to a solar panel at a check station'},
  {src:'/images/factory-real/warehouse.webp',title:'Packed for the next step',caption:'Finished cartons and palletised goods in the warehouse.',alt:'Packed solar-light cartons wrapped on pallets'}
];
const whatsappNumber = site.contact.whatsapp;
const image = (name: string) => imagePaths[name as keyof typeof imagePaths] || `/images/${name}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta name="theme-color" content="#0c1114" />
  <SEO title="NICETHRYUN — Solar lighting. From production to outdoors." description="Explore solar outdoor lighting for distributors, brands and projects. Find a product by application and prepare a quotation brief." />
  <TrackingHead />
  <link rel="icon" type="image/png" href="/images/b5-lineart.png" sizes="1254x1254" />
</head>
<body class="atrium-site">
<TrackingBody />
<a class="a-skip" href="#main-content">Skip to content</a>
<header class="a-header"><a class="a-brand" href="/" aria-label="NICETHRYUN solar lighting home"><BrandLogo /></a>
<nav class="a-nav" aria-label="Main navigation"><div class="a-dropdown"><button id="a-products-toggle" aria-expanded="false" aria-controls="a-product-menu">Products <span aria-hidden="true">⌄</span></button><div id="a-product-menu" class="a-mega" hidden><div><p class="a-label">SOLAR SECURITY</p><a href="/products/?family=sensor">Motion sensor lights ↗</a><a class="a-sub" href="/products/?type=multi">Multi-head lights</a><a class="a-sub" href="/products/?type=compact">Compact wall lights</a><a class="a-sub" href="/products/?type=split">Split-panel lights</a></div><div><p class="a-label">OUTDOOR RANGE</p><a href="/products/solar-flood/">Integrated solar lights ↗</a><a href="/products/?family=garden">Patio & pendant lights ↗</a><a href="/products/">Explore all products →</a><p class="a-mega-note">Select product families.<br />Build one quotation brief.</p></div></div></div><a href="#applications">Applications</a><a href="/manufacturing/">Factory</a><a href="/oem/">OEM / ODM</a><a href="/resources/">Resources</a></nav>
<div class="a-header-actions"><button class="a-quote-button" data-a-quote>Quote list <span class="a-quote-count">0</span><span aria-hidden="true">↗</span></button><button class="a-mobile-toggle" id="a-mobile-toggle" aria-expanded="false" aria-controls="a-mobile-menu" aria-label="Open navigation"><span></span><span></span></button></div></header>
<nav id="a-mobile-menu" class="a-mobile-menu" aria-label="Mobile navigation" hidden><a href="/products/">All products</a><a href="/products/?family=sensor">Motion sensor lights</a><a href="/products/solar-flood/">Integrated solar lights</a><a href="/products/?family=garden">Patio & pendant lights</a><a href="#applications">Applications</a><a href="/manufacturing/">Factory</a><a href="/oem/">OEM / ODM</a><a href="/resources/">Resources</a></nav>
<main id="main-content"><section class="a-hero" aria-labelledby="hero-title" data-light-mode="night">
<div class="a-hero-visual">
<div class="a-hero-backdrops" aria-hidden="true" data-rotation-interval="2000">{heroScenes.map((item,index)=><img class={`a-hero-background ${index===0?'is-active':''}`} data-hero-bg={item.id} data-caption={item.caption} data-kind={item.kind} data-product-bounds={item.productBounds?.join(',')} src={item.src} alt="" width="2400" height="1600" style={`object-position:${item.position}`} fetchpriority={index===0?'high':'low'} />)}</div>
<div class="a-hero-photo-shade"></div>
<div class="a-hero-brand-slot" aria-hidden="true"></div>

<div class="a-hero-background-info"><span id="a-bg-kind">Factory photograph</span><p id="a-bg-caption">On the production floor</p></div></div>
<div class="a-hero-art" id="solar-stage" aria-label="Luminous particle N shaped around solar panels and light"><img class="a-hero-poster" src="/images/brand/solar-n-lockup.png" alt="NICETHRYUN solar lighting — layered solar N brand lockup" /></div>
<div class="a-hero-copy"><p class="a-label a-hero-kicker"><span class="a-live-dot"></span>CHINA · SOLAR LIGHTING MANUFACTURING</p><h1 id="hero-title">Solar lighting.<br /><span>Made for<br class="a-mobile-break" /> outdoors.</span></h1><p class="a-hero-intro">See the production behind the product.<br />Solar outdoor lighting for distributors,<br class="a-desktop-br" /> brands and project partners.</p><div class="a-hero-actions"><a class="a-button a-button-light a-glass-primary" href="#products"><span class="a-glass-orb" aria-hidden="true"></span>Explore products <span aria-hidden="true">↗</span></a><a class="a-button a-button-outline" href="#factory-proof">Inside the factory <span aria-hidden="true">↓</span></a>{whatsappNumber && <a class="a-button a-button-outline a-whatsapp" href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer"><img src="/images/brand/whatsapp.svg" alt="" width="27" height="27" />WhatsApp <span aria-hidden="true">↗</span></a>}</div></div></section>
<section class="a-factory-proof a-inset" id="factory-proof" aria-labelledby="factory-proof-title"><div class="a-section-head"><div><p class="a-label">INSIDE PRODUCTION · FACTORY PHOTOGRAPHS</p><h2 id="factory-proof-title">See where the work happens.</h2></div><a class="a-button a-button-outline" href="/manufacturing/">Explore the factory <span aria-hidden="true">↗</span></a></div><div class="a-factory-proof-grid">{factoryProof.map(item=><a href="/manufacturing/" class="a-proof-card"><div class="a-proof-image"><img src={item.src} alt={item.alt} loading="lazy" width="900" height="675" /><span class="a-photo-tag">Factory photograph</span></div><div class="a-proof-copy"><h3>{item.title}<span aria-hidden="true">↗</span></h3><p>{item.caption}</p></div></a>)}</div><div class="a-proof-next"><p>Assembly. Panel checks. Packing.<br /><span>Start with the production process, then build your product range.</span></p><a href="/inquiry/">Discuss a factory visit or sample request ↗</a></div></section>
<div class="a-trade-strip"><span>FOR TRADE & PROJECTS</span><a href="/products/">Product selection ↗</a><a href="/oem/">Private-label possibilities ↗</a><a href="/resources/">Technical conversations ↗</a><a href="/inquiry/">One consolidated brief ↗</a></div>
<section class="a-applications" id="applications" aria-labelledby="applications-title"><div class="a-section-head a-inset"><div><p class="a-label">LIGHT IN CONTEXT</p><h2 id="applications-title">See the space.<br /><span>Find the right light.</span></h2></div><p>From daylight to after dark.<br />Explore the setting, then the product behind it.</p></div>
<SceneNavigator scenes={scenes} />
<div class="a-scene-stage">{scenes.map((scene,index)=><article id={`scene-panel-${scene.id}`} class={`a-scene-panel ${index===0?'is-active':''}`} role="tabpanel" aria-labelledby={`scene-tab-${scene.id}`} hidden={index!==0}>
<img class="a-scene-background" src={scene.image} alt={`Application concept: ${scene.hint}`} loading="lazy" width="1536" height="1024" /><div class="a-scene-scrim"></div><div class="a-scene-top"><span class="a-label">{scene.hint}</span><span class="a-concept-note">{scene.id==='coverage'||scene.id==='energy'?'Illustrative concept':'Application concept'}</span></div>
<div class="a-scene-content"><p class="a-label">{scene.chapter}</p><h3>{scene.title.split('\n').map(line=><span>{line}</span>)}</h3><p>{scene.body}</p><a class="a-text-link" href={`/products/${scene.product}/`}>Explore the product <span aria-hidden="true">↗</span></a></div><a class="a-scene-product" href={`/products/${scene.product}/`}><img src={image((products.find(p=>p.id===scene.product) || products[0]).image)} alt="" loading="lazy" /><span><small>EXPLORE THE FORMAT</small><b>{(products.find(p=>p.id===scene.product) || products[0]).name}</b><span>Product details ↗</span></span></a></article>)}</div><p class="a-scene-disclosure a-inset">Illustrative applications based on reference products. Placement, coverage and performance require a site assessment and selected-model data.</p></section>
<section class="a-products a-inset" id="products" aria-labelledby="products-title"><div class="a-section-head"><div><p class="a-label">THE SOLAR RANGE</p><h2 id="products-title">A format for your market.</h2></div><a class="a-text-link" href="/products/">Compare all products ↗</a></div><div class="a-product-filter" role="group" aria-label="Filter product families"><button data-range-filter="all" aria-pressed="true">All formats</button><button data-range-filter="sensor" aria-pressed="false">Security & sensors</button>{products.some(p=>p.family==='flood') && <button data-range-filter="flood" aria-pressed="false">Floodlights</button>}<button data-range-filter="garden" aria-pressed="false">Patio & pendant</button></div>
<div class="a-product-grid">{products.map(p=><article class="a-product-card" data-product-family={p.family}><a class={`a-product-image ${p.crop?'a-product-cropped':''}`} href={`/products/${p.id}/`} aria-label={`View ${p.name}`}><span class="a-product-tag">{p.tag}</span><img src={image(p.image)} alt={p.name} loading="lazy" width="480" height="350" /><span class="a-product-open" aria-hidden="true">↗</span></a><div class="a-product-copy"><p class="a-label">{p.panel}</p><h3><a href={`/products/${p.id}/`}>{p.name}</a></h3><p>{p.short}</p><div class="a-product-actions"><a href={`/products/${p.id}/`}>View product ↗</a><button data-a-add={p.id} aria-label={`Add ${p.name} to quote list`}>Add to quote +</button></div></div></article>)}</div><div class="a-range-foot"><p>Reference product families. Confirm output, battery, dimensions, runtime and destination documents with the selected model.</p><a href="/resources/">What to ask before ordering ↗</a></div></section>
<section class="a-manufacturing a-inset" aria-labelledby="manufacturing-title"><div class="a-manufacturing-copy"><p class="a-label">BEHIND THE PRODUCT</p><h2 id="manufacturing-title">From the workshop.<br /><span>To your product range.</span></h2><p>Walk through the workshop, view the equipment and explore the solar lighting formats. Bring your market, packaging and sample requirements into one manufacturing conversation.</p><a class="a-button a-button-outline" href="/manufacturing/">Manufacturing & quality ↗</a><a class="a-subtle-link" href="/oem/">Discuss branding & packaging →</a></div><div class="a-factory-grid"><a class="a-factory-main" href="/manufacturing/"><img src="/images/factory-real/production-daylight.webp" alt="Real daylit factory workshop with lighting assembly benches" loading="lazy" /><span>Product assembly ↗</span></a><a class="a-factory-small" href="/manufacturing/"><img src="/images/factory-real/moulding.webp" alt="Moulding machines in the factory workshop" loading="lazy" /><span>Moulding equipment ↗</span></a><a class="a-factory-small" href="/manufacturing/"><img src="/images/factory-real/showroom.webp" alt="Solar lighting and panel samples on display shelves" loading="lazy" /><span>Range development ↗</span></a><p class="a-factory-note">Factory photographs · Assembly, equipment and product samples.</p></div></section>
<section class="a-process a-inset" aria-labelledby="process-title"><div class="a-section-head"><div><p class="a-label">BUILT FOR B2B BUYING</p><h2 id="process-title">From a space to a specification.</h2></div><p>A straightforward path to a useful conversation.</p></div><ol><li><span>01</span><h3>Tell us the setting</h3><p>Market, application, mounting location and available sunlight.</p></li><li><span>02</span><h3>Choose the formats</h3><p>Shortlist product families and add your planned quantities.</p></li><li><span>03</span><h3>Confirm the details</h3><p>Review samples, operating modes, packaging and relevant documents.</p></li><li><span>04</span><h3>Prepare your brief</h3><p>Bring requirements together for quotation and lead-time discussion.</p></li></ol></section>
<section class="a-final-cta a-inset"><div><p class="a-label">YOUR NEXT OUTDOOR RANGE</p><h2>Let’s bring<br /><span>your project to light.</span></h2></div><div><p>Start with a product. Or start with a space.<br />Build a brief around what your business needs.</p><a class="a-button a-button-light" href="/inquiry/">Prepare an inquiry ↗</a><small>{inquiryLive ? <>Review your products and requirements.<br />Send your brief from the inquiry page.</> : <>Preview: save and export your brief locally.<br />No inquiry is sent from this demonstration.</>}</small></div></section></main>
<footer class="a-footer a-inset"><a class="a-brand" href="/"><span>NICETHRYUN<small>solar lighting</small></span></a><div><a href="/products/">Products</a><a href="/manufacturing/">Factory</a><a href="/resources/">Resources</a><a href="/inquiry/">Inquiry</a></div><span>Solar outdoor lighting.<br />For trade & project partners.</span></footer>
<dialog id="a-quote-dialog" class="a-quote-dialog" aria-labelledby="a-quote-title"><div class="a-quote-header"><div><p class="a-label">YOUR B2B SHORTLIST</p><h2 id="a-quote-title">Quote list.</h2></div><button class="a-dialog-close" data-a-close aria-label="Close quote list">×</button></div><div id="a-quote-items"></div><div class="a-quote-footer"><p>Quantities are planning requests. MOQ, configuration, pricing and lead time are confirmed in the final quotation.</p><a class="a-button a-button-light" href="/inquiry/">Continue to inquiry ↗</a><small>{inquiryLive ? "Saved in this browser · Send from the inquiry page" : "Saved in this browser · No submission or payment"}</small></div></dialog><div class="a-toast" id="a-toast" role="status" aria-live="polite" hidden></div><noscript><p class="a-noscript">Explore product details using the links above. Enable JavaScript for the interactive lighting experience and quote list.</p></noscript><script>import '../scripts/tracking.js'; import '../scripts/atrium-ui.js';</script></body></html>
