---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createTemplates } from '../lib/templates.js';
interface Props { page: string; id?: string; title?: string; description?: string; noindex?: boolean; thanks?: boolean }
const { page, id, title, description, noindex, thanks } = Astro.props;
const templates = createTemplates();
const html = page === 'renderCatalogue' ? templates.renderCatalogue(new URLSearchParams()) : templates[page](id);
const heading = html.match(/<h1(?: [^>]*)?>([\s\S]*?)<\/h1>/)?.[1]?.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
---
<BaseLayout title={title || `NICETHRYUN — ${heading || 'Solar security lighting'}`} description={description} noindex={noindex} thanks={thanks}>
  <Fragment set:html={html} />
</BaseLayout>
