---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dialogs from '../components/Dialogs.astro';
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'NICETHRYUN — Solar security lighting for your business', description = 'Explore NICETHRYUN solar security lighting for distributors, OEM brands and project buyers. Compare product families and build a quotation brief.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta name="theme-color" content="#092b30" />
    <SEO title={title} description={description} />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
    <Dialogs />
    <script>import '../scripts/site.js';</script>
  </body>
</html>
