---
import SEO from '../components/SEO.astro';
import TrackingHead from '../components/TrackingHead.astro';
import TrackingBody from '../components/TrackingBody.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dialogs from '../components/Dialogs.astro';
import { site } from '../config/site.mjs';
import { icon } from '../lib/icons.js';
import '../styles/global.css';
import '../styles/atrium-inner.css';
interface Props { title?: string; description?: string; noindex?: boolean; thanks?: boolean }
const { title = 'NICETHRYUN — Solar security lighting for your business', description = 'Explore NICETHRYUN solar security lighting for distributors, OEM brands and project buyers. Compare product families and build a quotation brief.', noindex = false, thanks = false } = Astro.props;
const whatsapp = site.contact.whatsapp;
---
<!doctype html>
<html lang="en">
  <head>
    <meta name="theme-color" content="#092b30" />
    <SEO title={title} description={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <TrackingHead />
    <link rel="icon" type="image/png" href="/images/b5-lineart.png" sizes="1254x1254" />
  </head>
  <body data-thanks={thanks ? '' : undefined}>
    <TrackingBody />
    <Header />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
    <Dialogs />
    {whatsapp && (
      <a
        class="wa-fab"
        data-wa-fab
        href={`https://wa.me/${whatsapp}?text=${encodeURIComponent('Hello NICETHRYUN, I would like a quotation for solar lights.')}`}
        target="_blank"
        rel="noopener"
        aria-label="Chat with us on WhatsApp"
        set:html={`${icon('message-circle')}<span>WhatsApp</span>`}
      />
    )}
    <script>import '../scripts/site.js';</script>
  </body>
</html>
